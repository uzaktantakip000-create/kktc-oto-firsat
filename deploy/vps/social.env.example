# /etc/kktc-social/social.env — sosyal okuyucunun ayarları (sahibi root, grubu kktc-social, izin 640).
# BU DOSYA ÖRNEKTİR. Gerçek değerleri YALNIZ VPS'teki /etc/kktc-social/social.env dosyasına yaz; repoya ASLA yazma.
# Biçim (systemd EnvironmentFile): her satır ANAHTAR=değer; tırnak gerekmez; # ile başlayan satır açıklamadır.
# Aşağıdaki örnek IP'ler (203.0.113.x, 198.51.100.x) belge adresleridir: değiştirmezsen güvenlik duvarı kurulmaz.
# Telegram/OpenRouter anahtarları buraya YAZILMAZ (bildirimleri GitHub tarafı gönderir).

# Durum dosyaları (oturum, imleç, kilit, deneme çıktıları) ve kaynak listesi
SOCIAL_STATE_DIR=/var/lib/kktc-social
SOCIAL_SOURCES_CSV=/etc/kktc-social/sources.csv

# Proxy: http://KULLANICI:SIFRE@IP:PORT
#  - IP olmalı (alan adı DEĞİL); güvenlik duvarı yalnız bu IP:port'a izin verir.
#  - Her platforma AYRI Türkiye sabit ISP IP'si. Şifrede @ : / # ? % gibi işaretler olmasın.
SOCIAL_PROXY_FACEBOOK=http://PROXY_KULLANICI:PROXY_SIFRE@203.0.113.10:12323
SOCIAL_PROXY_INSTAGRAM=http://PROXY_KULLANICI:PROXY_SIFRE@203.0.113.20:12323

# Proxy'den çıkınca sitelerin gördüğü IP (sağlayıcının verdiği sabit IP). İkisi FARKLI olmalı.
# ISP proxy'lerinde çoğu zaman yukarıdaki proxy IP'si ile aynıdır.
SOCIAL_EXPECTED_IP_FACEBOOK=198.51.100.10
SOCIAL_EXPECTED_IP_INSTAGRAM=198.51.100.20

# trial = deneme: sonuçlar yalnız /var/lib/kktc-social/trial/ altındaki dosyalara yazılır (veritabanına değil)
SOCIAL_MODE=trial

# 0 = tarayıcı görünür çalışır (sanal ekran :99). Değiştirme.
SOCIAL_HEADLESS=0
