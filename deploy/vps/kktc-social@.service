# deploy/vps/kktc-social@.service — sosyal okuyucunun TEK turu (oneshot).  %i = facebook | instagram
# setup.sh / kktc-deploy bu dosyayı /etc/systemd/system/ altına kopyalar (orada elle düzenleme; bir sonraki güncellemede ezilir).
# Tetikleyen: kktc-social@%i.timer (20 dk'da bir). Turun gerçekten gerekip gerekmediğine (KKTC gündüz penceresi, ~2 saat aralık,
# fren) okuyucu kendisi karar verir; gerekmiyorsa hemen çıkar.
[Unit]
Description=KKTC sosyal okuyucu turu (%i)
Documentation=file:///opt/kktc-social/app/deploy/vps/README.md
# Güvenlik duvarı ya da sanal ekran başlatılamazsa tur da BAŞLAMAZ (fail-closed).
Requires=kktc-firewall.service kktc-xvfb.service
After=kktc-firewall.service kktc-xvfb.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kktc-social
Group=kktc-social
EnvironmentFile=/etc/kktc-social/social.env
WorkingDirectory=/opt/kktc-social/app
Environment=DISPLAY=:99
Environment=HOME=/var/lib/kktc-social
Environment=TMPDIR=/var/lib/kktc-social/tmp/%i
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/kktc-social/ms-playwright
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# (1) root olarak ("+"): güvenlik duvarı tablosu yerinde mi? Biri silmişse (ör. `nft flush ruleset`) dosyadan yeniden yükle;
#     yine yoksa bu satır hata verir ve tur BAŞLAMAZ.
ExecStartPre=+/bin/sh -c 'nft list table inet kktc_social 2>/dev/null | grep -q kktc_social_final_drop || { echo "kktc_social kurali yok, dosyadan yeniden yukleniyor" >&2; nft -f /etc/kktc-social/firewall.nft; }; nft list table inet kktc_social | grep -q kktc_social_final_drop'
# (2) platforma ayrı geçici klasör; 4 saatten eski artıkları (çökmüş tarayıcı profili) temizle. Başarısız olursa tur yine başlar ("-").
ExecStartPre=/bin/mkdir -p /var/lib/kktc-social/tmp/%i
ExecStartPre=-/usr/bin/find /var/lib/kktc-social/tmp/%i -mindepth 1 -maxdepth 1 -mmin +240 -exec rm -rf -- {} +
ExecStart=/opt/kktc-social/venv/bin/python -m entrypoints.social_worker run %i
TimeoutStartSec=45min
SyslogIdentifier=kktc-social-%i
# Bellek: tur başına 2 GB, sosyal tarafın tamamı (kktc-social.slice) 3 GB; aynı VPS'teki araç botuna yer kalsın.
Slice=kktc-social.slice
MemoryMax=2G

# --- Sıkılaştırma (Chromium'un çalışmasına izin verecek kadar) ---
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/kktc-social
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
# BİLEREK KAPALI:
#  PrivateTmp      — sanal ekranın soketi /tmp/.X11-unix/X99'da; özel /tmp onu gizler. Bunun yerine /tmp bu süreç için SALT-OKUNUR
#                    (ProtectSystem=strict) ve geçici dosyalar TMPDIR'e (/var/lib/kktc-social/tmp/%i) yazılır.
#  MemoryDenyWriteExecute — Chromium'un JavaScript motoru (V8 JIT) çalışmaz.
#  PrivateDevices, RestrictNamespaces, SystemCallFilter, ProtectClock — Chromium'u kırma riski; kazancı küçük.
#  PrivateNetwork  — okuyucu proxy'ye çıkmak zorunda; ağ kısıtı nftables'ta (kktc-firewall.service).
